<Window x:Class="PBL3.UI.Views.wInPhieuNhapKho"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phiếu Nhập Kho" Height="780" Width="500"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <Border Background="White" Margin="20,20,20,10" CornerRadius="16" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="PHIẾU NHẬP KHO" FontSize="24" FontWeight="Heavy" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                    <TextBlock Text="TTN Milk Tea Management " FontSize="13" Foreground="#7A7A7A" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="Địa chỉ: Đại học Bách Khoa - Đại học Đà Nẵng" FontSize="12" Foreground="#7A7A7A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock Text="Điện thoại: 0833 584 225" FontSize="12" Foreground="#7A7A7A" HorizontalAlignment="Center" Margin="0,2,0,25"/>

                    <Border Background="#F9FAFB" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#E5E7EB" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="MÃ PHIẾU NHẬP" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblMaPhieu" Grid.Row="1" Grid.Column="0" Text="#0000" FontSize="16" FontWeight="Bold" Foreground="#1A1A1A" Margin="0,4,0,15"/>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="NGÀY NHẬP" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblNgayNhap" Grid.Row="1" Grid.Column="1" Text="01/01/2026 • 10:00" FontSize="16" FontWeight="Bold" Foreground="#4CAF50" Margin="0,4,0,15"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="NHÂN VIÊN NHẬP" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblNhanVien" Grid.Row="3" Grid.Column="0" Text="NV#101" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"/>

                            <TextBlock Grid.Row="2" Grid.Column="1" Text="SỐ MỤC HÀNG" FontSize="11" Foreground="#A0A0A0" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblSoMuc" Grid.Row="3" Grid.Column="1" Text="5 mục" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                        </Grid>
                    </Border>

                    <Path Stroke="#EBEBEB" StrokeThickness="1.5" StrokeDashArray="4,4" Data="M 0,0 L 400,0" Stretch="Fill" Margin="0,10,0,20"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="NGUYÊN LIỆU" FontSize="12" FontWeight="Bold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="1" Text="SỐ LƯỢNG" FontSize="12" FontWeight="Bold" Foreground="#6B7280" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="ĐƠN GIÁ" FontSize="12" FontWeight="Bold" Foreground="#6B7280" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="THÀNH TIỀN" FontSize="12" FontWeight="Bold" Foreground="#6B7280" TextAlignment="Right"/>
                    </Grid>

                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,0,0,15" Padding="0,15,0,0">
                        <ItemsControl x:Name="icChiTiet">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding TenNguyenLieu}" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                            <TextBlock Text="{Binding DonVi}" FontSize="11" Foreground="#7A7A7A" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding SoLuong}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DonGia, StringFormat='{}{0:N0} đ'}" FontSize="13" Foreground="#1A1A1A" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ThanhTien, StringFormat='{}{0:N0} đ'}" FontSize="13" FontWeight="SemiBold" Foreground="#4CAF50" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Path Stroke="#EBEBEB" StrokeThickness="1.5" StrokeDashArray="4,4" Data="M 0,0 L 400,0" Stretch="Fill" Margin="0,5,0,20"/>

                    <StackPanel Margin="0,0,0,25">
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Cộng nguyên liệu" FontSize="13" Foreground="#7A7A7A"/>
                            <TextBlock x:Name="lblCongNguyenLieu" Text="0 đ" FontSize="13" Foreground="#7A7A7A" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="TỔNG CHI PHÍ" FontSize="18" FontWeight="Heavy" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTongChiPhi" Text="0 đ" FontSize="22" FontWeight="Heavy" Foreground="#4CAF50" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="2" CornerRadius="8" Padding="15" Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="✓ NHẬP KHO THÀNH CÔNG" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Tổng mục hàng: " FontSize="12" Foreground="#2E7D32"/>
                                <TextBlock x:Name="lblTongMuc" Text="0" FontSize="12" FontWeight="Bold" Foreground="#2E7D32"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tổng tiền: " FontSize="12" Foreground="#2E7D32"/>
                                <TextBlock x:Name="lblTongTien" Text="0 đ" FontSize="12" FontWeight="Bold" Foreground="#2E7D32"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Phiếu nhập kho này được in từ hệ thống quản lý" FontSize="11" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock x:Name="lblThoiGianIn" Text="Thời gian in: 01/01/2026 10:00:00" FontSize="10" Foreground="#BDBDBD" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Xin cảm ơn quý công ty!" FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" Padding="20,15" BorderBrush="#EBEBEB" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="btnIn_Click" Height="48" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#4CAF50" CornerRadius="12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="IN PHIẾU" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Click="btnDong_Click" Height="48" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#6B7280" CornerRadius="12">
                                <TextBlock Text="ĐÓNG" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>